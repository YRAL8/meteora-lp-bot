# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Telegram ---
# Bot token from @BotFather, and the chat id allowed to command the bot.
# Commands from any other chat are ignored.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# --- Network ---
# DRY_RUN=true pins everything to devnet regardless of any other setting.
# Mainnet additionally requires METEORA_ALLOW_MAINNET=1 in the process
# environment — deliberately not placed in this file.
DRY_RUN=true

# --- Wallet ---
# Path to a Solana JSON keypair. Keep it outside the repository.
WALLET_KEYPAIR_PATH=~/.config/solana/meteora-devnet.json

# --- Pool and RPC ---
# Default pool is SOL-USDC on mainnet; override for devnet rehearsals.
DLMM_LB_PAIR=5rCf1DM8LjKTw4YqhnoLcngyZYeNnQqztScTogYHAS6
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Seconds between monitoring ticks.
POLL_INTERVAL_SEC=300

# --- Auto-rebalance (C4) ---
# Default OFF. Flip to true only when you consciously want the bot to spend.
AUTO_REBALANCE=false

# Minutes out of range before acting. Measured optimum for ±1.37%: ~62% of
# exits return within 20 min; longer waits lose more idle fees than they save.
REBALANCE_DELAY_MIN=20

# Meteora storm guards (absent on Orca — rebalances fire far more often here).
# Min gap between two auto-rebalances (minutes).
MIN_REBALANCE_INTERVAL_MIN=60
# Hard daily cap; at the limit the bot notifies and pauses auto until UTC midnight.
MAX_REBALANCES_PER_DAY=6

# Reminder cadence while out-of-range and not acting (hours).
REBALANCE_BLOCKED_REMINDER_HOURS=1

# SOL below this blocks the auto action (not monitoring). Timer is kept.
# Must cover position rent (~0.057 SOL for 69 bins) + fee headroom; Python
# prefers balances.solAvailableForOpen when present.
MIN_SOL_BALANCE=0.08

# Cap on how large a position may be (USD). Empty = no cap: after rebalance the
# bot puts nearly the whole wallet into the pool (same model as Orca). Set a
# number (e.g. 50) so a fat wallet cannot accidentally dump everything into LP
# on the first rebalance — especially useful on thin devnet pools.
# REQUIRED when AUTO_REBALANCE=true on mainnet.
# MAX_POSITION_USD=50

# Priority fee in microlamports per compute unit (TS + Python). Default 50000 ≈
# Helius "medium" / reliable inclusion without overpaying. Override if congested.
PRIORITY_FEE_MICROLAMPORTS=50000

# Payback diagnosis only (never blocks). Median cycle life vs ~2.8h payback
# (swap ≈0.02% of position / in-range earn ≈0.0071%/h).
REBALANCE_PAYBACK_HOURS=2.8
UNECONOMIC_LOOKBACK_CYCLES=5

# Used only by the standalone position reader (meteora_position.py).
REQUEST_SLEEP_S=0.25
